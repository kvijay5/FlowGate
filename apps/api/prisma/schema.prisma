generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING

  @@map("tenant_status")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  REQUESTER
  APPROVER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED

  @@map("user_status")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("workflow_status")
}

enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  CHANGES_REQUESTED

  @@map("approval_request_status")
}

enum StepStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  SKIPPED

  @@map("step_status")
}

enum NotificationChannel {
  EMAIL
  SLACK_MOCK

  @@map("notification_channel")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("delivery_status")
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("webhook_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

enum StepPolicy {
  SEQUENTIAL
  PARALLEL_AND
  PARALLEL_OR

  @@map("step_policy")
}

enum RejectionPolicy {
  SOFT_REJECTION
  STRICT_VETO

  @@map("rejection_policy")
}

enum DelegationStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED

  @@map("delegation_status")
}

enum NodeExecutionStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  SKIPPED
  FAILED
  CANCELLED

  @@map("node_execution_status")
}

enum BranchExecutionStatus {
  NOT_EVALUATED
  ACTIVE
  COMPLETED
  PRUNED_SKIPPED
  FAILED
  CANCELLED

  @@map("branch_execution_status")
}

// =============================================================================
// Models
// =============================================================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relationships
  users                    User[]
  workflowDefinitions      WorkflowDefinition[]
  approvalRequests         ApprovalRequest[]
  approvalSteps            ApprovalStep[]
  approvalStepAssignees    ApprovalStepAssignee[]
  workflowNodeExecutions   WorkflowNodeExecution[]
  workflowBranchExecutions WorkflowBranchExecution[]
  userDelegations          UserDelegation[]
  auditLogs                AuditLog[]
  auditChainHead           AuditChainHead?
  notifications            NotificationLog[]
  webhookSubscriptions     WebhookSubscription[]
  webhookDeliveries        WebhookDelivery[]
  outboxEvents             OutboxEvent[]
  inboundWebhookEvents     InboundWebhookEvent[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String     @db.VarChar(255)
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(REQUESTER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequests       ApprovalRequest[]      @relation("UserApprovalRequests")
  assignedSteps          ApprovalStep[]         @relation("UserAssignedSteps")
  actionedSteps          ApprovalStep[]         @relation("UserActionedSteps")
  escalatedSteps         ApprovalStep[]         @relation("UserEscalatedSteps")
  assignedStepAssignees  ApprovalStepAssignee[] @relation("AssigneeAssignedTo")
  actionedStepAssignees  ApprovalStepAssignee[] @relation("AssigneeActionedBy")
  delegatedStepAssignees ApprovalStepAssignee[] @relation("AssigneeDelegatedFrom")
  delegationsGiven       UserDelegation[]       @relation("DelegatorUser")
  delegationsReceived    UserDelegation[]       @relation("DelegateeUser")
  auditLogs              AuditLog[]             @relation("UserAuditLogs")
  notifications          NotificationLog[]

  // Multi-tenant uniqueness
  @@unique([tenantId, email], name: "tenant_user_email_unique")
  @@unique([tenantId, id], name: "tenant_user_id_unique")
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@map("users")
}

model WorkflowDefinition {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String         @db.VarChar(255)
  description   String?        @db.Text
  status        WorkflowStatus @default(DRAFT)
  configuration Json           @default("{}")
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relationships
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]
  delegations      UserDelegation[]

  @@unique([tenantId, id], name: "tenant_workflow_id_unique")
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("workflow_definitions")
}

model ApprovalRequest {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  workflowDefinitionId String                    @map("workflow_definition_id") @db.Uuid
  requestedById        String                    @map("requested_by_id") @db.Uuid
  title                String                    @db.VarChar(255)
  description          String?                   @db.Text
  requestData          Json                      @default("{}") @map("request_data")
  status               ApprovalRequestStatus     @default(PENDING)
  workflowVersion      Int                       @default(1) @map("workflow_version")
  workflowSnapshot     Json?                     @map("workflow_snapshot")
  currentNodeId        String?                   @map("current_node_id") @db.VarChar(100)
  currentReviewRound   Int                       @default(1) @map("current_review_round")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  // Relationships (Composite FKs: Database enforces tenant consistency)
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition        @relation(fields: [tenantId, workflowDefinitionId], references: [tenantId, id], onDelete: Restrict)
  requestedBy        User                      @relation("UserApprovalRequests", fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict)
  steps              ApprovalStep[]
  nodeExecutions     WorkflowNodeExecution[]
  branchExecutions   WorkflowBranchExecution[]

  @@unique([tenantId, id], name: "tenant_request_id_unique")
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, requestedById])
  @@index([workflowDefinitionId])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  approvalRequestId String                 @map("approval_request_id") @db.Uuid
  reviewRound       Int                    @default(1) @map("review_round")
  nodeId            String                 @default("legacy_step") @map("node_id") @db.VarChar(100)
  nodeType          String                 @default("APPROVAL_STEP") @map("node_type") @db.VarChar(50)
  stepName          String                 @default("Approval Step") @map("step_name") @db.VarChar(255)
  stepOrder         Int                    @map("step_order")
  branchKey         String?                @map("branch_key") @db.VarChar(150)
  policy            StepPolicy             @default(SEQUENTIAL)
  rejectionPolicy   RejectionPolicy        @default(SOFT_REJECTION) @map("rejection_policy")
  totalAssigned     Int                    @default(1) @map("total_assigned")
  requiredApprovals Int                    @default(1) @map("required_approvals")
  approvedCount     Int                    @default(0) @map("approved_count")
  rejectedCount     Int                    @default(0) @map("rejected_count")
  assignedToId      String?                @map("assigned_to_id") @db.Uuid
  assignedRole      UserRole?              @map("assigned_role")
  actionedById      String?                @map("actioned_by_id") @db.Uuid
  actionedAt        DateTime?              @map("actioned_at")
  status            StepStatus             @default(PENDING)
  comments          String?                @db.Text
  reminderCount     Int                    @default(0) @map("reminder_count")
  lastRemindedAt    DateTime?              @map("last_reminded_at")
  isEscalated       Boolean                @default(false) @map("is_escalated")
  escalatedAt       DateTime?              @map("escalated_at")
  escalatedToRole   UserRole?              @map("escalated_to_role")
  escalatedToUserId String?                @map("escalated_to_user_id") @db.Uuid
  escalationReason  String?                @map("escalation_reason") @db.VarChar(255)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  // Relationships (Composite FKs: Database enforces tenant consistency)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest        @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Cascade)
  assignedTo      User?                  @relation("UserAssignedSteps", fields: [tenantId, assignedToId], references: [tenantId, id], onDelete: SetNull)
  actionedBy      User?                  @relation("UserActionedSteps", fields: [tenantId, actionedById], references: [tenantId, id], onDelete: SetNull)
  escalatedTo     User?                  @relation("UserEscalatedSteps", fields: [tenantId, escalatedToUserId], references: [tenantId, id], onDelete: SetNull)
  assignees       ApprovalStepAssignee[]

  // Enforces unique step order within an approval request review round
  @@unique([approvalRequestId, reviewRound, stepOrder], name: "request_round_step_order_unique")
  @@unique([tenantId, id], name: "tenant_step_id_unique")
  @@index([tenantId])
  @@index([approvalRequestId, reviewRound])
  @@index([assignedToId])
  @@index([tenantId, assignedRole])
  @@index([actionedById])
  @@index([escalatedToUserId])
  @@index([tenantId, escalatedToRole])
  @@index([tenantId, nodeId])
  @@map("approval_steps")
}

model ApprovalStepAssignee {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  stepId              String     @map("step_id") @db.Uuid
  reviewRound         Int        @default(1) @map("review_round")
  assignedToId        String?    @map("assigned_to_id") @db.Uuid
  assignedRole        UserRole?  @map("assigned_role")
  status              StepStatus @default(PENDING)
  actionedById        String?    @map("actioned_by_id") @db.Uuid
  delegatedFromUserId String?    @map("delegated_from_user_id") @db.Uuid
  actionedAt          DateTime?  @map("actioned_at")
  comments            String?    @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step              ApprovalStep @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  assignedTo        User?        @relation("AssigneeAssignedTo", fields: [tenantId, assignedToId], references: [tenantId, id], onDelete: SetNull)
  actionedBy        User?        @relation("AssigneeActionedBy", fields: [tenantId, actionedById], references: [tenantId, id], onDelete: SetNull)
  delegatedFromUser User?        @relation("AssigneeDelegatedFrom", fields: [tenantId, delegatedFromUserId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId])
  @@index([stepId])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, assignedRole, status])
  @@map("approval_step_assignees")
}

model WorkflowNodeExecution {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  approvalRequestId String              @map("approval_request_id") @db.Uuid
  reviewRound       Int                 @default(1) @map("review_round")
  nodeId            String              @map("node_id") @db.VarChar(100)
  nodeType          String              @map("node_type") @db.VarChar(50)
  status            NodeExecutionStatus @default(PENDING)
  activatedAt       DateTime?           @map("activated_at")
  completedAt       DateTime?           @map("completed_at")
  executionData     Json?               @default("{}") @map("execution_data")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([approvalRequestId, reviewRound, nodeId])
  @@index([tenantId, status])
  @@map("workflow_node_executions")
}

model WorkflowBranchExecution {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  approvalRequestId String                @map("approval_request_id") @db.Uuid
  reviewRound       Int                   @default(1) @map("review_round")
  branchKey         String                @map("branch_key") @db.VarChar(150)
  sourceNodeId      String                @map("source_node_id") @db.VarChar(100)
  targetNodeId      String                @map("target_node_id") @db.VarChar(100)
  status            BranchExecutionStatus @default(NOT_EVALUATED)
  activatedAt       DateTime?             @map("activated_at")
  completedAt       DateTime?             @map("completed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([approvalRequestId, reviewRound, branchKey])
  @@index([tenantId, targetNodeId, status])
  @@map("workflow_branch_executions")
}

model UserDelegation {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  delegatorId          String           @map("delegator_id") @db.Uuid
  delegateeId          String           @map("delegatee_id") @db.Uuid
  workflowDefinitionId String?          @map("workflow_definition_id") @db.Uuid
  delegateRoles        Boolean          @default(true) @map("delegate_roles")
  roles                String[]         @default([]) @map("roles")
  startDate            DateTime         @map("start_date")
  endDate              DateTime         @map("end_date")
  status               DelegationStatus @default(ACTIVE)
  reason               String?          @db.VarChar(500)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delegator          User                @relation("DelegatorUser", fields: [tenantId, delegatorId], references: [tenantId, id], onDelete: Cascade)
  delegatee          User                @relation("DelegateeUser", fields: [tenantId, delegateeId], references: [tenantId, id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition? @relation(fields: [tenantId, workflowDefinitionId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, delegateeId, status, startDate, endDate])
  @@index([tenantId, delegatorId, status])
  @@map("user_delegations")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.VarChar(100)
  action         String   @db.VarChar(100)
  metadata       Json     @default("{}")
  previousHash   String?  @map("previous_hash") @db.VarChar(64)
  hash           String?  @map("hash") @db.VarChar(64)
  sequenceNumber Int?     @map("sequence_number")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships (Composite FK: Database enforces tenant consistency; No updatedAt: strictly append-only)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("UserAuditLogs", fields: [tenantId, actorId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, sequenceNumber], name: "tenant_audit_sequence_unique")
  @@index([tenantId])
  @@index([tenantId, sequenceNumber])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model AuditChainHead {
  tenantId       String    @id @map("tenant_id") @db.Uuid
  lastHash       String    @map("last_hash") @db.VarChar(64)
  sequenceNumber Int       @default(0) @map("sequence_number")
  lastCreatedAt  DateTime? @map("last_created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_chain_heads")
}

model NotificationLog {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  recipientEmail  String              @map("recipient_email") @db.VarChar(255)
  recipientUserId String?             @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel @default(EMAIL)
  eventType       String              @map("event_type") @db.VarChar(100)
  subject         String              @db.VarChar(255)
  content         String              @db.Text
  status          DeliveryStatus      @default(PENDING)
  idempotencyKey  String              @map("idempotency_key") @db.VarChar(255)
  attemptCount    Int                 @default(0) @map("attempt_count")
  errorMessage    String?             @map("error_message") @db.Text
  metadata        Json                @default("{}")
  sentAt          DateTime?           @map("sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User?  @relation(fields: [tenantId, recipientUserId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey], name: "tenant_notification_idempotency_unique")
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@index([recipientUserId])
  @@map("notification_logs")
}

model WebhookSubscription {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String        @db.VarChar(255)
  url          String        @db.VarChar(1024)
  secret       String        @db.VarChar(255)
  eventTypes   Json          @default("[]") @map("event_types")
  status       WebhookStatus @default(ACTIVE)
  failureCount Int           @default(0) @map("failure_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([tenantId, id], name: "tenant_webhook_subscription_id_unique")
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  subscriptionId String         @map("subscription_id") @db.Uuid
  eventId        String         @default(uuid()) @map("event_id") @db.Uuid
  eventType      String         @map("event_type") @db.VarChar(100)
  payload        Json           @default("{}")
  status         DeliveryStatus @default(PENDING)
  httpStatusCode Int?           @map("http_status_code")
  attemptCount   Int            @default(0) @map("attempt_count")
  maxAttempts    Int            @default(3) @map("max_attempts")
  nextRetryAt    DateTime?      @map("next_retry_at")
  requestHeaders Json?          @map("request_headers")
  responseBody   String?        @map("response_body") @db.Text
  errorMessage   String?        @map("error_message") @db.Text
  durationMs     Int?           @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tenantId, eventId])
  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@map("webhook_deliveries")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(50)
  entityId       String       @map("entity_id") @db.Uuid
  payload        Json         @map("payload")
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  maxRetries     Int          @default(5) @map("max_retries")
  lastError      String?      @map("last_error") @db.Text
  idempotencyKey String       @map("idempotency_key") @db.VarChar(255)
  scheduledFor   DateTime     @default(now()) @map("scheduled_for")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([status, scheduledFor])
  @@index([tenantId, entityId])
  @@index([createdAt])
  @@map("outbox_events")
}

model InboundWebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  eventId        String   @map("event_id") @db.VarChar(255)
  eventType      String   @map("event_type") @db.VarChar(100)
  source         String   @default("EXTERNAL") @db.VarChar(100)
  processedAt    DateTime @default(now()) @map("processed_at")
  expiresAt      DateTime @map("expires_at")
  payloadSummary Json?    @map("payload_summary")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([expiresAt])
  @@map("inbound_webhook_events")
}
